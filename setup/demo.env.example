# Copy to demo.env and edit. demo.env is git-ignored. Never commit real tokens.

# --- Target versions --------------------------------------------------------
EXPECTED_OCP_MINOR="4.22"          # customer target; OCP 5.x intentionally not used
OLS_CHANNEL="stable"               # lightspeed-operator 2.0.x
OLS_NAMESPACE="openshift-lightspeed"

# --- LLM provider for OLSConfig (used only if no OLSConfig exists yet) -----
# LLM_TYPE: openai | azure_openai | watsonx | rhoai_vllm | rhelai_vllm | anthropic | bedrock ...
LLM_TYPE="openai"
LLM_PROVIDER_NAME="demo-llm"
LLM_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o"
AZURE_DEPLOYMENT_NAME=""           # required when LLM_TYPE=azure_openai
WATSONX_PROJECT_ID=""              # required when LLM_TYPE=watsonx
# The API key is read from the LLM_API_TOKEN environment variable at run time,
# e.g.  read -rs LLM_API_TOKEN && export LLM_API_TOKEN && ./20-apply-olsconfig.sh

# --- Demo workloads ---------------------------------------------------------
CATALOG_NS="bowland-widget-factory"
INVENTORY_NS="bowland-inventory"

# --- MCP server for Red Hat OpenShift (IDE act) ------------------------------
MCP_NS="openshift-mcp-server"
# Leave blank to derive mcp-server.<apps-domain> automatically
MCP_HOST=""
MCP_TOOLSETS="core,config,metrics"
